{
  "name": "thynora-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "THYNORAのReactフロントエンドをCapacitorでiOS/Androidアプリとして配布するための設定",
  "scripts": {
    "config:apply": "node apply-config.cjs",
    "sync": "npm run config:apply && npx cap sync",
    "open:ios": "npx cap open ios",
    "open:android": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "7.6.9",
    "@capacitor/cli": "7.6.9",
    "@capacitor/core": "7.6.9",
    "@capacitor/ios": "7.6.9"
  }
}
