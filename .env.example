# このファイルを .env という名前でコピーして、実際の値を入れてください。
# 例: cp .env.example .env

# Claude API キー(outline.py で使用)
# https://console.anthropic.com/ で取得できます。
ANTHROPIC_API_KEY=

# OpenAlex の polite pool 用メールアドレス(search.py で使用、任意)
# 設定しなくても動きますが、設定するとレート制限が緩くなります。
OPENALEX_MAILTO=

# APIの認証トークン(任意)。空のままならローカル運用のデフォルトとして認証なしで動作する。
# 値を設定すると、全APIリクエストに X-API-Key ヘッダーでの一致を必須にする
# (ngrok/tailscale等で外部公開する場合など)。フロントエンドのサイドバー下部の
# 「APIキー」欄に同じ値を入力すること。
API_AUTH_TOKEN=

# /generate のレート制限(1分あたりの上限リクエスト数、誤操作等によるClaude APIコスト
# 暴走を防ぐため)。0以下で無効化。
GENERATE_RATE_LIMIT_PER_MINUTE=20
