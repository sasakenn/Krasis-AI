# このファイルを .env という名前でコピーして、実際の値を入れてください。
# 例: cp .env.example .env

# Claude API キー(outline.py で使用)
# https://console.anthropic.com/ で取得できます。
ANTHROPIC_API_KEY=

# OpenAlex の polite pool 用メールアドレス(search.py で使用、任意)
# 設定しなくても動きますが、設定するとレート制限が緩くなります。
OPENALEX_MAILTO=

# /generate のレート制限(ユーザーごとの1分あたりの上限リクエスト数、誤操作等による
# Claude APIコスト暴走を防ぐため)。0以下で無効化。
GENERATE_RATE_LIMIT_PER_MINUTE=20

# --- 認証(Apple / Google / GitHub でのログイン) ---

# Sign in with Apple のServices ID(またはBundle ID)。identity tokenのaudクレームと
# 一致することを要求する。Apple Developer Program登録後、Apple Developer portalで
# 「Identifiers」から作成して取得する。未設定だとApple側のサインインが常に失敗する。
APPLE_CLIENT_ID=

# GoogleのOAuthクライアントID。Google Cloud Console(console.cloud.google.com)で
# 「APIとサービス」→「認証情報」からOAuthクライアントID(ウェブアプリケーション)を
# 作成して取得する(無料)。未設定だとGoogle側のサインインが常に失敗する。
GOOGLE_CLIENT_ID=

# GitHub OAuth Appの Client ID / Client Secret。GitHubの
# Settings → Developer settings → OAuth Apps から作成して取得する(無料)。
# 未設定だとGitHub側のサインインが常に失敗する。
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# メールアドレス+乱数コードでのログイン(Google/GitHub等のアカウントを使いたくない
# 場合向け)。SMTP設定が無くても機能自体は動く(コードは画面にも表示されるし、
# メール本文はログに出力されるだけになる)が、実際にメールで届けるには以下が必要。
# Gmailなら「アプリパスワード」を発行してSMTP_PASSWORDに使うと簡単。
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# メール+コードのサインアップ/再発行の乱用(他人のメールへのスパム送信等)を防ぐ、
# メールアドレスごとの1分あたりの上限リクエスト数。0以下で無効化。
CODE_AUTH_RATE_LIMIT_PER_MINUTE=5

# アプリ独自セッションJWTの署名鍵。本番では `openssl rand -hex 32` 等で生成した
# 長いランダム値を設定すること。未設定だとどのプロバイダーでもサインイン後のトークン
# 発行・検証が常に失敗する。
JWT_SECRET=

# 開発時のみ: 設定すると、(1) `X-Dev-User-Id` ヘッダーで任意のuser_idを名乗って
# APIを直接叩ける、(2) ブラウザのログイン画面に「開発用ログイン」ボタンが現れ、
# ワンクリックでこの固定ユーザーとしてログインできる(実プロバイダーの認証情報が
# 無くても動作確認できる)。本番環境では絶対に設定しないこと(誰でも他人になりすませる)。
DEV_BYPASS_USER_ID=

# --- 課金(Stripeサブスク) ---
# いずれも空のままなら /billing/* は503を返すだけで、他の機能には一切影響しない。

# Stripeダッシュボード(dashboard.stripe.com)の「開発者」→「APIキー」から取得する
# シークレットキー(sk_test_... / sk_live_...)。
STRIPE_SECRET_KEY=

# StripeダッシュボードでWebhookエンドポイント(/billing/webhook宛)を登録すると
# 発行される署名検証用シークレット(whsec_...)。ローカル確認には
# `stripe listen --forward-to localhost:8000/billing/webhook` を使うと簡単。
STRIPE_WEBHOOK_SECRET=

# Stripeダッシュボードで作成した月額プラン(商品)のPrice ID(price_...)。
# pro/max それぞれの月額プランを作成してから設定する。
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_MAX=

# Checkout/カスタマーポータル完了後にユーザーを戻す先。本番ではデプロイ先の
# フロントエンドのURLを設定する(未設定時は開発用に http://localhost:5173 を使う)。
FRONTEND_ORIGIN=http://localhost:5173
