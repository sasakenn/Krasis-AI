# このファイルを .env という名前でコピーして、実際の値を入れてください。
# 例: cp .env.example .env
# (Viteの仕様上、VITE_ で始まる変数だけがビルド後のフロントエンドコードに埋め込まれる)

# バックエンドの.envに設定したのと同じ値を使う(未設定でも動くが、該当プロバイダーの
# ログインボタンが無効表示になる)。

# Sign in with Apple のServices ID
VITE_APPLE_CLIENT_ID=

# GoogleのOAuthクライアントID
VITE_GOOGLE_CLIENT_ID=

# GitHub OAuth Appの Client ID
VITE_GITHUB_CLIENT_ID=

# GitHub OAuth Appの「Authorization callback URL」に登録したのと同じURL。
# 未設定なら現在のオリジン(window.location.origin)を使う。
VITE_GITHUB_REDIRECT_URI=
